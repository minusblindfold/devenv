#!/usr/bin/env bash
set -euo pipefail

# Usage: open-diagrams <design-file>
# Opens each .mmd diagram referenced in the design doc in a browser tab.

if [[ -z "${1:-}" ]]; then
  echo "Usage: open-diagrams <design-file>" >&2
  exit 1
fi

design_file=$(realpath "$1")
design_dir=$(dirname "$design_file")

# Find diagrams referenced in the design doc under ## Diagrams
# Matches lines like: - [title](diagrams/some-file.mmd)
diagram_refs=()
while IFS= read -r ref; do
  diagram_refs+=("$ref")
done < <(grep -oE 'diagrams/[^)]+\.mmd' "$design_file" || true)

if [[ ${#diagram_refs[@]} -eq 0 ]]; then
  echo "No diagram references found in $design_file" >&2
  exit 1
fi

diagrams=()
for ref in "${diagram_refs[@]}"; do
  path="$design_dir/$ref"
  if [[ -f "$path" ]]; then
    diagrams+=("$path")
  else
    echo "Warning: referenced diagram not found: $path" >&2
  fi
done

if [[ ${#diagrams[@]} -eq 0 ]]; then
  echo "No diagram files found" >&2
  exit 1
fi

script_dir="$(dirname "$(realpath "$0")")"
template="$script_dir/../templates/open-diagrams.html"

if [[ ! -f "$template" ]]; then
  echo "Template not found: $template" >&2
  exit 1
fi

for mmd in "${diagrams[@]}"; do
  name=$(basename "$mmd" .mmd)
  escaped_content=$(sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g' "$mmd")
  tmpfile="$(mktemp).html"

  # Split template at {{DIAGRAM_CONTENT}} and inject escaped content between halves
  split_line=$(grep -n '{{DIAGRAM_CONTENT}}' "$template" | head -1 | cut -d: -f1)
  head_part=$(sed -n "1,$((split_line - 1))p" "$template")
  tail_part=$(sed -n "$((split_line + 1)),\$p" "$template")
  {
    echo "$head_part" | sed "s|{{DIAGRAM_NAME}}|$name|g"
    echo "$escaped_content"
    echo "$tail_part" | sed "s|{{DIAGRAM_NAME}}|$name|g"
  } >"$tmpfile"

  open "$tmpfile"
done
